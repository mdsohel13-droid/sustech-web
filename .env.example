# Public site
SITE_URL=https://beta.sustechltd.com
NEXT_PUBLIC_SERVER_URL=https://beta.sustechltd.com   # public origin (admin links, live preview, sitemap)
SITE_INDEXABLE=false            # false on beta, true at production cutover

# CMS (Payload) — runs in-process in this Next app; admin at /admin.
# The site reads PUBLISHED content via Payload's local API (no network hop, no read token).
DATABASE_URI=postgres://user:password@127.0.0.1:5432/sustech_cms   # CMS Postgres (private network in prod)
PAYLOAD_SECRET=                 # long random string; signs auth tokens. NEVER commit a real value.
PREVIEW_SECRET=                 # guards the /api/preview draft-preview entry point
REVALIDATE_SECRET=              # guards on-demand revalidation called by Payload publish hooks

# Chat proxy (server-side only; never exposed to client)
ANTHROPIC_API_KEY=
CHAT_RATE_LIMIT=30
# Web-chat widget → n8n webhook (server-side; the widget posts via a server action).
# Set this to your n8n webhook, e.g. https://n8n.sustechltd.com/webhook/sustech-chat
CHAT_WEBHOOK_URL=
# Open-ended AI assistant → n8n webhook. The browser posts to the same-origin
# /api/chat route, which forwards { message, user_ref, secret, image? } here.
# Keeping it server-side hides the secret and stays inside the strict CSP.
CHAT_N8N_ENDPOINT=               # e.g. https://n8n.sustechltd.com/webhook/chat
CHAT_WIDGET_SECRET=              # shared secret the n8n workflow verifies on each request

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Project importer (operational tool, run locally by Hermes/admin — NOT used by the web app)
IMPORT_SOURCE=excel                       # excel (now) | erp (later — one-value source swap)
DATA_FILE=data/clients-pipeline.xlsx      # gitignored sensitive workbook; never committed

# Hermes AI content agent — daily GEO/AEO content pipeline
HERMES_AGENT_SECRET=              # long random string; authenticates POST /api/hermes/ingest and GET /api/hermes/content-brief
# Comma-separated categories that Hermes may auto-publish without human review.
# Omit or leave blank to require human approval for ALL categories (safest default).
# Only low-risk categories should be listed here: industry-news, ai-tech, market-insight
# Never include: company-update, product-update (those contain Sustech-specific claims)
HERMES_AUTO_PUBLISH_CATEGORIES=   # e.g. "industry-news,ai-tech,market-insight"

# NOTE: no ERP credentials here. Ever. Hermes owns ERP access on the ops tier and writes
# to the CMS over the API as a DRAFT-ONLY service account — it cannot publish.
