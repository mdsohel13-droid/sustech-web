# Public site
SITE_URL=https://beta.sustechltd.com
NEXT_PUBLIC_SERVER_URL=https://beta.sustechltd.com   # public origin (admin links, live preview, sitemap, CORS/CSRF allowlist). MUST match the host in the browser or admin saves fail with "not allowed".
SITE_INDEXABLE=false            # false on beta, true at production cutover
EXTRA_ORIGINS=                  # optional, comma-separated extra origins allowed for admin CORS/CSRF (e.g. https://beta.sustechltd.com). apex+www of NEXT_PUBLIC_SERVER_URL are added automatically.

# CMS (Payload) — runs in-process in this Next app; admin at /admin.
# The site reads PUBLISHED content via Payload's local API (no network hop, no read token).
DATABASE_URI=postgres://user:password@127.0.0.1:5432/sustech_cms   # CMS Postgres (private network in prod)
PAYLOAD_SECRET=                 # long random string; signs auth tokens. NEVER commit a real value.
PREVIEW_SECRET=                 # guards the /api/preview draft-preview entry point
REVALIDATE_SECRET=              # guards on-demand revalidation called by Payload publish hooks

# Chat proxy (server-side only; never exposed to client)
ANTHROPIC_API_KEY=
CHAT_RATE_LIMIT=30
# Web-chat widget → n8n webhook (server-side; the widget posts via a server action).
# Set this to your n8n webhook, e.g. https://n8n.sustechltd.com/webhook/sustech-chat
CHAT_WEBHOOK_URL=
# Open-ended AI assistant → n8n webhook. The browser posts to the same-origin
# /api/chat route, which forwards { message, user_ref, secret, image? } here.
# Keeping it server-side hides the secret and stays inside the strict CSP.
CHAT_N8N_ENDPOINT=               # e.g. https://n8n.sustechltd.com/webhook/chat
CHAT_WIDGET_SECRET=              # shared secret the n8n workflow verifies on each request

# Analytics — cookieless PostHog via the same-origin /ingest proxy (lib/analytics/*).
# Leave empty to disable analytics entirely (client + server both no-op).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=          # e.g. https://app.posthog.com (or EU host)

# Lead Engine (master plan Phase 1/1b + GrowthOS integration brief §3).
# All server-side only. Each surface 404s/no-ops while its secret is unset.
LEADENGINE_INGEST_SECRET=          # HMAC secret for POST /api/leads/ingest (GrowthOS promotion door)
LEADENGINE_REPORTER_KEY=           # Bearer key for GET /api/leads/suppression-hashes (read-only feed)
LEADENGINE_EVENTS_URL=             # n8n/GrowthOS webhook that receives HMAC-signed lead events
LEADENGINE_EVENTS_SECRET=          # HMAC secret for the events webhook above
LEADS_CONFIRM_SECRET=              # signs double-opt-in confirm tokens (GET /api/leads/confirm)
GATED_DOWNLOAD_SECRET=            # signs 24h gated-asset download tokens (GET /api/download/[id])
REPORTS_SECRET=                  # signs 30-day calculator report links (/reports/[leadId]/[token])

# Lead follow-up notifications (instant email + ERP/CRM forward; both optional, non-blocking)
LEAD_ALERT_EMAIL=                # owner inbox that gets an instant email per new lead
LEAD_ALERT_FROM=                 # From header, e.g. "Sustech Leads <leads@sustechltd.com>" (verified Resend domain)
RESEND_API_KEY=                  # Resend key for the lead-alert email (and the daily-report cron)
LEAD_FORWARD_URL=                # HMAC POST of the FULL lead -> a Hermes/n8n endpoint that pushes to the ERP/CRM
LEAD_FORWARD_SECRET=             # HMAC secret for LEAD_FORWARD_URL (web tier NEVER calls the ERP directly)

# Content pipeline & approval (Phase 4 — nightly source-watch + guarded auto-publish)
SOURCE_WATCH_ENABLED=true         # master kill switch for the nightly pipeline (run-start 409s when false)
AUTOMATION_KILL_SWITCH=false      # env-level halt: blocks the sweep + auto-publish even if the DB toggle is on
PIPELINE_SECRET=                  # n8n -> /api/pipeline/* (run-start/finish, sources, affected, revise, sweep)
CRON_SECRET=                      # VPS crontab ONLY -> /api/cron/nightly + /api/cron/indexnow (detect-only / re-index; never publishes)
INDEXNOW_KEY=                     # optional; a random 16-32 char hex string. Enables IndexNow instant re-crawl (Bing/Yandex) on publish. Leave blank to disable. Only pings when NEXT_PUBLIC_SERVER_URL is https (prod).
APPROVAL_TOKEN_SECRET=            # signs one-click approve/reject JWTs (HS256); distinct from PAYLOAD_SECRET
APPROVAL_TTL_HOURS=72             # approval link lifetime
AUTO_PUBLISH_ENABLED=false        # ship OFF; owner flips on only after >=2 weeks of shadow-mode logs
AUTO_PUBLISH_AFTER_HOURS=24       # hours after email DELIVERY before the auto path may fire
AUTO_PUBLISH_CATEGORIES=industry-news-roundup,knowledge-explainer,glossary   # the ONLY auto-publishable categories
AUTO_PUBLISH_DAILY_CAP=5          # max auto-publishes per day (runaway backstop)
OWNER_NOTIFY_EMAIL=               # where n8n sends the approval digest + "published without review" notices

# Project importer (operational tool, run locally by Hermes/admin — NOT used by the web app)
IMPORT_SOURCE=excel                       # excel (now) | erp (later — one-value source swap)
DATA_FILE=data/clients-pipeline.xlsx      # gitignored sensitive workbook; never committed

# Hermes AI content agent — daily GEO/AEO content pipeline
HERMES_AGENT_SECRET=              # long random string; authenticates POST /api/hermes/ingest and GET /api/hermes/content-brief
# Comma-separated categories that Hermes may auto-publish without human review.
# Omit or leave blank to require human approval for ALL categories (safest default).
# Only low-risk categories should be listed here: industry-news, ai-tech, market-insight
# Never include: company-update, product-update (those contain Sustech-specific claims)
HERMES_AUTO_PUBLISH_CATEGORIES=   # e.g. "industry-news,ai-tech,market-insight"

# NOTE: no ERP credentials here. Ever. Hermes owns ERP access on the ops tier and writes
# to the CMS over the API as a DRAFT-ONLY service account — it cannot publish.
